# Copy to .env and adjust. All optional — defaults shown.
PORT=8080
# Frontend origin allowed by CORS (browser-enforced only, not real auth).
ALLOWED_ORIGIN=http://localhost:5173
CONFIG_PATH=config.json
MESSAGES_PATH=reasons.json
DEFAULT_COUNTRY=ID
RATE_LIMIT_PER_MINUTE=30
# Demo only: fake the clock (RFC3339). Empty = real time.
# Pretend it's Saturday in Jakarta: 2026-08-15T10:00:00+07:00
NOW_OVERRIDE=
